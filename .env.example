PSYCHOLOGY_ROULETTE_PORT=8080
# Enable only during a planned data cutover; API requests return 503 except health.
PSYCHOLOGY_ROULETTE_MAINTENANCE_MODE=false
# Hosted deployments use the Neon pooled runtime URL. Leave unset locally
# to keep using backend/data/psychology-roulette.sqlite3.
# PSYCHOLOGY_ROULETTE_DATABASE_URL=postgresql://psychology_roulette_runtime:REDACTED@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require
PSYCHOLOGY_ROULETTE_ROOM_TTL_SECONDS=604800
PSYCHOLOGY_ROULETTE_CREATE_LIMIT=10
PSYCHOLOGY_ROULETTE_CREATE_WINDOW_SECONDS=600
PSYCHOLOGY_ROULETTE_JOIN_LIMIT=30
PSYCHOLOGY_ROULETTE_JOIN_WINDOW_SECONDS=60
# Private Qwen gateway for fresh game packs and end-of-game recaps.
# Curated questions are used only when this service is unset or unavailable.
# PSYCHOLOGY_ROULETTE_AI_BASE_URL=https://ai.example.com
# PSYCHOLOGY_ROULETTE_AI_TOKEN=generate-a-long-random-secret
PSYCHOLOGY_ROULETTE_AI_TIMEOUT_SECONDS=45
